{
 "title": "IN THIS TOWN, NOBODY IS ALLOWED TO SLEEP",
 "duration": 60,
 "layout": "auto",
 "captions": "words",
 "voice": "am_onyx",
 "speed": 1.19,
 "narration": [
  {
   "gap": 0.15,
   "text": "In this town, falling asleep for even one second could make you disappear forever.",
   "hl": [
    "disappear",
    "forever."
   ]
  },
  {
   "gap": 0.12,
   "text": "Nobody knew why it started."
  },
  {
   "gap": 0.1,
   "text": "But every morning, another house would be found empty.",
   "hl": [
    "empty."
   ]
  },
  {
   "gap": 0.12,
   "text": "The beds were still warm. The food was still on the table. But the people were gone.",
   "hl": [
    "gone."
   ]
  },
  {
   "gap": 0.12,
   "text": "The government ordered everyone to stay awake, and the entire town became desperate.",
   "hl": [
    "stay",
    "awake,"
   ]
  },
  {
   "gap": 0.12,
   "text": "One night, a seventeen-year-old boy named Alex was riding the bus home when his eyes suddenly closed.",
   "say": "One night, a seventeen year old boy named Alex was riding the bus home, when his eyes suddenly closed.",
   "hl": [
    "Alex"
   ]
  },
  {
   "gap": 0.38,
   "text": "When he woke up, the bus was moving through an empty city.",
   "hl": [
    "empty"
   ]
  },
  {
   "gap": 0.1,
   "text": "Every street was deserted. Every building was dark. Even the radio had stopped working."
  },
  {
   "gap": 0.1,
   "text": "He jumped off and ran to the nearest house."
  },
  {
   "gap": 0.1,
   "text": "But when he opened the basement door, he found hundreds of people sleeping inside.",
   "hl": [
    "hundreds"
   ]
  },
  {
   "gap": 0.25,
   "text": "Then he noticed something."
  },
  {
   "gap": 0.12,
   "text": "Every person in those beds had his face.",
   "hl": [
    "his",
    "face."
   ]
  },
  {
   "gap": 0.12,
   "text": "Suddenly, a television turned on. A man wearing a suit appeared and said…"
  },
  {
   "gap": 0.1,
   "text": "“Experiment 438. The subject has awakened.”",
   "say": "Experiment four thirty-eight. The subject has awakened.",
   "voice": "bm_lewis",
   "speed": 1.02,
   "fx": "tv",
   "hl": [
    "438."
   ]
  },
  {
   "gap": 0.1,
   "text": "Alex stepped backward. Then the man continued…"
  },
  {
   "gap": 0.1,
   "text": "“Begin the final test.”",
   "say": "Begin the final test.",
   "voice": "bm_lewis",
   "speed": 0.95,
   "fx": "tv",
   "hl": [
    "final",
    "test.”"
   ]
  },
  {
   "gap": 0.1,
   "text": "And suddenly, every sleeping version of Alex opened their eyes."
  },
  {
   "gap": 0.1,
   "text": "But the real Alex was standing outside the room."
  },
  {
   "gap": 0.55,
   "text": "So… who was actually dreaming?",
   "say": "So... who was actually dreaming?",
   "hl": [
    "who",
    "was",
    "actually",
    "dreaming?"
   ]
  }
 ],
