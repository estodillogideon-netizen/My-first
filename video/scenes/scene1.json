    { "t": 11.6, "text": "Then the list said two." },
    { "t": 14.6, "text": "Someone was standing at the edge of the map." },
    { "t": 18.4, "text": "No name. No face." },
    { "t": 21.2, "text": "And every time Max looked away..." },
    { "t": 23.9, "text": "it got closer." }
