{
 "title": "IN THIS TOWN, YOU HAD TO PAY FOR EVERY WORD",
 "duration": 114,
 "layout": "auto",
 "captions": "words",
 "voice": "am_michael",
 "speed": 1.12,
 "duck": 0.75,
 "bed_gain": 0.45,
 "narration": [
  {
   "gap": 0.08,
   "text": "In this town, every word you said cost money.",
   "voice": "am_michael",
   "speed": 1.12,
   "hl": [
    "money."
   ]
  },
  {
   "gap": 0.12,
   "text": "Say hello? One coin.",
   "voice": "am_michael",
   "speed": 1.12,
   "hl": [
    "One",
    "coin."
   ]
  },
  {
   "gap": 0.12,
   "text": "Say I love you? TEN!",
   "voice": "am_michael",
   "speed": 1.12,
   "hl": [
    "TEN!"
   ],
   "say": "Say I love you? Ten!"
  },
  {
   "gap": 0.12,
   "text": "And if you went broke… you could never speak again!",
   "voice": "am_michael",
   "speed": 1.12,
   "hl": [
    "broke…",
    "never",
    "speak"
   ],
   "say": "And if you went broke... you could never speak again!"
  },
  {
   "gap": 0.2,
   "text": "HEY! WATCH WHERE YOU'RE GOING!",
   "voice": "am_eric",
   "speed": 1.15,
   "who": "CITIZEN",
   "say": "Hey! Watch where you're going!"
  },
  {
   "gap": 0.3,
   "text": "OH COME ON! THAT WAS THREE WORDS!",
   "voice": "am_eric",
   "speed": 1.15,
   "who": "CITIZEN",
   "hl": [
    "THREE"
   ],
   "say": "Oh come on! That was three words!"
  },
  {
   "gap": 1.4,
   "text": "THREE COINS?! That's literally all I have!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "hl": [
    "THREE",
    "COINS?!"
   ],
   "say": "Three coins?! That's literally all I have!"
  },
  {
   "gap": 0.4,
   "text": "Mom, can I have some money?",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS"
  },
  {
   "gap": 0.15,
   "text": "No! You spent everything yesterday!",
   "voice": "af_heart",
   "speed": 1.02,
   "who": "MOM",
   "hl": [
    "everything"
   ]
  },
  {
   "gap": 0.15,
   "text": "But I barely even talked yesterday!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "hl": [
    "barely"
   ]
  },
  {
   "gap": 0.7,
   "text": "Then… who was talking for you?",
   "voice": "af_heart",
   "speed": 1.02,
   "who": "MOM",
   "hl": [
    "who"
   ],
   "say": "Then... who was talking for you?"
  },
  {
   "gap": 1.4,
   "text": "Lucas checked his phone. Hundreds of voice messages had been sent from his account… but he never recorded a single one.",
   "voice": "am_michael",
   "speed": 1.18,
   "hl": [
    "Hundreds",
    "never"
   ],
   "say": "Lucas checked his phone. Hundreds of voice messages had been sent from his account... but he never recorded a single one."
  },
  {
   "gap": 0.15,
   "text": "What the heck?! I didn't send these!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS"
  },
  {
   "gap": 0.8,
   "text": "Tomorrow, don't talk to anyone. Especially the mayor.",
   "voice": "am_echo",
   "speed": 0.88,
   "who": "???",
   "hl": [
    "mayor."
   ],
   "fx": "ghost"
  },
  {
   "gap": 0.2,
   "text": "WHAT?!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "hl": [
    "WHAT?!"
   ],
   "say": "What?!"
  },
  {
   "gap": 2.2,
   "text": "Citizens! Someone has been stealing words without paying! And today… we're finding them!",
   "voice": "am_onyx",
   "speed": 0.98,
   "who": "MAYOR",
   "hl": [
    "stealing"
   ],
   "say": "Citizens! Someone has been stealing words without paying! And today... we're finding them!"
  },
  {
   "gap": 0.15,
   "text": "WHAT'S HAPPENING TO MY MONEY?!",
   "voice": "am_eric",
   "speed": 1.15,
   "who": "CITIZEN",
   "hl": [
    "MONEY?!"
   ],
   "say": "What's happening to my money?!"
  },
  {
   "gap": 0.1,
   "text": "I CAN'T AFFORD TO SAY THAT!",
   "voice": "bf_emma",
   "speed": 1.15,
   "who": "CITIZEN",
   "hl": [
    "AFFORD"
   ],
   "say": "I can't afford to say that!"
  },
  {
   "gap": 0.6,
   "text": "IT'S THE MAYOR!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "hl": [
    "MAYOR!"
   ],
   "say": "It's the mayor!"
  },
  {
   "gap": 0.4,
   "text": "Interesting…",
   "voice": "am_onyx",
   "speed": 0.98,
   "who": "MAYOR",
   "say": "Interesting..."
  },
  {
   "gap": 0.35,
   "text": "Bring that boy to me.",
   "voice": "am_onyx",
   "speed": 0.98,
   "who": "MAYOR"
  },
  {
   "gap": 0.12,
   "text": "WAIT! WHY ME?!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "say": "Wait! Why me?!"
  },
  {
   "gap": 0.15,
   "text": "Because you've been speaking for free.",
   "voice": "am_onyx",
   "speed": 0.98,
   "who": "MAYOR",
   "hl": [
    "free."
   ]
  },
  {
   "gap": 0.12,
   "text": "I DIDN'T DO ANYTHING!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "say": "I didn't do anything!"
  },
  {
   "gap": 0.5,
   "text": "That's exactly what the last person said.",
   "voice": "am_onyx",
   "speed": 0.98,
   "who": "MAYOR",
   "hl": [
    "last",
    "person"
   ]
  },
  {
   "gap": 5.0,
   "text": "Then every phone in town rang at exactly the same time.",
   "voice": "am_michael",
   "speed": 1.12,
   "hl": [
    "every",
    "phone"
   ]
  },
  {
   "gap": 1.0,
   "text": "If you're hearing this… I've already taken every word you've ever said.",
   "voice": "am_echo",
   "speed": 0.88,
   "who": "???",
   "hl": [
    "taken"
   ],
   "say": "If you're hearing this... I've already taken every word you've ever said.",
   "fx": "ghost"
  },
  {
   "gap": 0.3,
   "text": "NO! TURN OFF THE SPEAKERS!",
   "voice": "am_onyx",
   "speed": 0.98,
   "who": "MAYOR",
   "say": "No! Turn off the speakers!"
  },
  {
   "gap": 2.6,
   "text": "Wait… the mayor can't speak?!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "hl": [
    "can't",
    "speak?!"
   ],
   "say": "Wait... the mayor can't speak?!"
  },
  {
   "gap": 1.6,
   "text": "Lucas found a hidden speaker inside the mayor's podium. It wasn't stealing money… it was stealing people's voices.",
   "voice": "am_michael",
   "speed": 1.12,
   "hl": [
    "hidden",
    "speaker",
    "voices."
   ],
   "say": "Lucas found a hidden speaker inside the mayor's podium. It wasn't stealing money... it was stealing people's voices."
  },
  {
   "gap": 0.2,
   "text": "Then who's controlling it?!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "hl": [
    "controlling"
   ]
  },
  {
   "gap": 0.9,
   "text": "THANK YOU, LUCAS.",
   "voice": "am_echo",
   "speed": 0.88,
   "who": "???",
   "say": "Ha. Ha. Ha. Thank you, Lucas.",
   "fx": "ghost"
  },
  {
   "gap": 0.2,
   "text": "What?!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS"
  },
  {
   "gap": 0.3,
   "text": "You just gave me my voice back.",
   "voice": "am_echo",
   "speed": 0.88,
   "who": "???",
   "hl": [
    "voice",
    "back."
   ],
   "fx": "ghost"
  },
  {
   "gap": 1.6,
   "text": "Lucas realized the voice wasn't trapped inside the speaker.",
   "voice": "am_michael",
   "speed": 0.98,
   "hl": [
    "wasn't"
   ]
  },
  {
   "gap": 0.6,
   "text": "I was trapped inside YOUR phone.",
   "voice": "am_echo",
   "speed": 0.88,
   "who": "???",
   "hl": [
    "YOUR",
    "phone."
   ],
   "fx": "ghost"
  },
  {
   "gap": 0.4,
   "text": "NO… WAIT!",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "LUCAS",
   "say": "No... wait!"
  },
  {
   "gap": 3.0,
   "text": "Finally… I can talk.",
   "voice": "am_puck",
   "speed": 0.9,
   "who": "???",
   "say": "Finally... I can talk.",
   "fx": "ghostlucas"
  },
  {
   "gap": 3.0,
   "text": "Help me…",
   "voice": "am_puck",
   "speed": 0.85,
   "who": "LUCAS",
   "say": "Help me...",
   "fx": "whisper"
  }
