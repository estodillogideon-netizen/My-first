{
 "title": "IN THIS TOWN, YOU GET ARRESTED FOR TELLING THE TRUTH",
 "duration": 60,
 "layout": "auto",
 "captions": "words",
 "voice": "am_onyx",
 "speed": 1.17,
 "duck": 0.75,
 "bed_gain": 0.42,
 "narration": [
  {
   "gap": 0.1,
   "text": "In this town, telling the truth was illegal.",
   "voice": "am_onyx",
   "speed": 1.22,
   "hl": [
    "the",
    "truth",
    "illegal."
   ]
  },
  {
   "gap": 0.12,
   "text": "Every citizen was required to lie at least once a day.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.12,
   "text": "If you told the truth, the police would immediately know.",
   "voice": "am_onyx",
   "speed": 1.22,
   "hl": [
    "the",
    "truth,"
   ]
  },
  {
   "gap": 0.18,
   "text": "Mom, why do we have to lie?",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "ALEX"
  },
  {
   "gap": 0.18,
   "text": "Because the truth gets people taken away.",
   "voice": "af_nicole",
   "speed": 1.05,
   "who": "MOM",
   "hl": [
    "the",
    "truth"
   ]
  },
  {
   "gap": 0.18,
   "text": "Alex never believed her.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.1,
   "text": "Until one morning, his teacher asked the entire class a simple question.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.18,
   "text": "Who stole the money from my desk?",
   "voice": "bm_george",
   "speed": 1.08,
   "who": "TEACHER"
  },
  {
   "gap": 0.15,
   "text": "Everyone blamed someone else.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.12,
   "text": "But Alex stood up.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.18,
   "text": "It was you, sir. I saw you take it.",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "ALEX"
  },
  {
   "gap": 0.22,
   "text": "The classroom suddenly went silent.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.1,
   "text": "The teacher's smile disappeared.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.18,
   "text": "Did you just tell the truth?",
   "voice": "bm_george",
   "speed": 1.08,
   "who": "TEACHER",
   "hl": [
    "the",
    "truth?"
   ]
  },
  {
   "gap": 0.15,
   "text": "Within seconds, police surrounded the school.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.1,
   "text": "Alex ran through the hallway, but every door was locked.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.1,
   "text": "Then his best friend grabbed his arm.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.15,
   "text": "Don't worry. I know a way out.",
   "voice": "am_liam",
   "speed": 1.12,
   "who": "LEO"
  },
  {
   "gap": 0.15,
   "text": "Why are you helping me?",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "ALEX"
  },
  {
   "gap": 0.15,
   "text": "Because I was arrested yesterday.",
   "voice": "am_liam",
   "speed": 1.12,
   "who": "LEO",
   "hl": [
    "arrested"
   ]
  },
  {
   "gap": 0.18,
   "text": "Alex stared at him.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.15,
   "text": "And I discovered something. The police aren't arresting people for telling the truth.",
   "voice": "am_liam",
   "speed": 1.12,
   "who": "LEO",
   "hl": [
    "arresting",
    "the",
    "truth."
   ]
  },
  {
   "gap": 0.15,
   "text": "Then why?",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "ALEX"
  },
  {
   "gap": 0.15,
   "text": "Because the truth reveals who's actually controlling this town.",
   "voice": "am_liam",
   "speed": 1.12,
   "who": "LEO",
   "hl": [
    "the",
    "truth",
    "controlling"
   ]
  },
  {
   "gap": 0.18,
   "text": "Suddenly, every screen turned on.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.1,
   "text": "And Alex's face appeared.",
   "voice": "am_onyx",
   "speed": 1.22
  },
  {
   "gap": 0.18,
   "text": "THE NEXT MAYOR HAS BEEN FOUND.",
   "voice": "am_onyx",
   "speed": 1.22,
   "hl": [
    "THE",
    "NEXT",
    "MAYOR"
   ],
   "say": "The next mayor has been found."
  },
  {
   "gap": 0.22,
   "text": "What does that mean?",
   "voice": "am_puck",
   "speed": 1.1,
   "who": "ALEX"
  }
 ],
